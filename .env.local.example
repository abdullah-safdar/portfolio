# Copy this file to .env.local and fill in real values from app.tina.io
# (create a TinaCloud project, connect this GitHub repo, then use the
# Overview tab for the Client ID and the Tokens tab for a Read Only Token).
# .env.local is gitignored -- never commit real values.

# Overview tab -> Client ID
NEXT_PUBLIC_TINA_CLIENT_ID=

# Tokens tab -> Read Only Token
TINA_TOKEN=

# The git branch TinaCloud should read/write content on. Defaults to
# GITHUB_BRANCH / VERCEL_GIT_COMMIT_REF / HEAD / "main" if unset --
# see tina/config.ts.
NEXT_PUBLIC_TINA_BRANCH=main
